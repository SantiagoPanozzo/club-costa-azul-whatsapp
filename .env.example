# Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Conservative interactive-list body limit; increase only after checking the API version.
WHATSAPP_LIST_BODY_LIMIT=1024

# Club Costa Azul services API
SERVICES_API_BASE_URL=https://api.example.com
BOT_API_KEY=

# History and task telemetry (the conversation state itself remains in memory).
MONGODB_URL=mongodb://localhost:27017/club_costa_azul
ROUTER_SECRET=
# Optional local metrics cohort; Railway uses RAILWAY_GIT_COMMIT_SHA automatically.
BOT_RELEASE=local

LOG_LEVEL=INFO
