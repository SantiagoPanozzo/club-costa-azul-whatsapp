# Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# Club Costa Azul services API
SERVICES_API_BASE_URL=https://api.example.com
BOT_API_KEY=
ROUTER_SHARED_SECRET=replace-with-a-long-random-secret-shared-with-the-router

# Shared bot state (use a persistent Redis service in staging/production)
SESSION_REDIS_URL=redis://localhost:6379/1
REQUIRE_REDIS=false
SESSION_TTL_SECONDS=1800
MEMBER_REVALIDATE_SECONDS=300

# Message storage
MONGODB_URL=mongodb://localhost:27017/club_costa_azul

# User-facing destinations
FRONTEND_URL=https://front-prod-production-0420.up.railway.app
CLUB_CONTACT_TEXT=Comunicate con administración del club.

LOG_LEVEL=INFO
